{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Tech Video Editorial Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "language",
    "headline",
    "summary",
    "sources",
    "claims",
    "video"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "const": "es-ES"
    },
    "headline": {
      "type": "string",
      "minLength": 8,
      "maxLength": 130
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "published_at"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "published_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_urls",
          "classification"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "classification": {
            "enum": [
              "verified",
              "analysis",
              "simulation"
            ]
          }
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "format",
        "duration_seconds",
        "voice_locale",
        "publish_requires_approval"
      ],
      "properties": {
        "format": {
          "const": "vertical-9:16"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 35,
          "maximum": 90
        },
        "voice_locale": {
          "const": "es-ES"
        },
        "publish_requires_approval": {
          "const": true
        }
      }
    }
  }
}
